<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of OmniFind's goes to cloud backup or to a new phone. The index describes the phone's own files
     (and is rebuilt from them), and the model downloads again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
